# ConfiguraciÃ³n Apache/LiteSpeed para https://destapacionesconmaquina.com.ar/
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio canÃ³nico: HTTPS y sin www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.destapacionesconmaquina\.com\.ar$ [NC]
  RewriteRule ^ https://destapacionesconmaquina.com.ar%{REQUEST_URI} [R=301,L,NE]

  # Variantes habituales de la portada anterior.
  RewriteRule ^(?:index\.php|home|inicio)/?$ https://destapacionesconmaquina.com.ar/ [R=301,L,NE]

  # ParÃ¡metros de portada de WordPress: se conserva una Ãºnica URL canÃ³nica.
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=[^&]+ [NC]
  RewriteRule ^ https://destapacionesconmaquina.com.ar/ [R=301,L,NE,QSD]

  # Rutas automÃ¡ticas de WordPress que no existen en la nueva one page.
  RewriteRule ^(?:author|gallery|attachment|category|tag|feed|comments)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-admin|wp-includes|wp-content|wp-json)(?:/|$) - [G,L,NC]
  RewriteRule ^xmlrpc\.php$ - [G,L,NC]

  # Bloquea archivos ocultos, salvo el desafÃ­o estÃ¡ndar de Let's Encrypt.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

# CompresiÃ³n de texto si el mÃ³dulo estÃ¡ habilitado en Hostinger.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

# CachÃ© de recursos estÃ¡ticos versionables.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ============================================================================
# HARDENING CONDE GRAPHICS - Bloquear documentos internos
# Los .md son notas de trabajo/briefs internos, no contenido del sitio.
# ============================================================================
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|markdown)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.gitignore$">
    Require all denied
  </FilesMatch>
</IfModule>